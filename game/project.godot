; Engine configuration file.
; IDLE PARTY: Desktop Legends

config_version=5

[application]

config/name="Idle Party: Desktop Legends"
config/description="A cozy idle party RPG that lives above your taskbar."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/low_processor_mode=true
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
config/icon="res://assets/ui/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="IdleParty"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DataDB="*res://scripts/core/data_db.gd"
Settings="*res://scripts/core/settings.gd"
UITheme="*res://scripts/ui/ui_theme.gd"
GameState="*res://scripts/core/game_state.gd"
TimeService="*res://scripts/core/time_service.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
SteamService="*res://scripts/core/steam_service.gd"
BattleSim="*res://scripts/sim/battle_sim.gd"
WindowManager="*res://scripts/core/window_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=84
window/size/window_width_override=960
window/size/window_height_override=168
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=false

[gui]

timers/tooltip_delay_sec=0.25

[input]

boss_key={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":true,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":72,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

common/physics_ticks_per_second=30
2d/run_on_separate_thread=false

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/native_method_override=1
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_call_argument=0
